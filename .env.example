# Calendly scheduling link (create a "Free Consultation" event type and paste its URL)
# e.g. https://calendly.com/<your-username>/30min (from the dhruv.desai1706@gmail.com Calendly account)
NEXT_PUBLIC_CALENDLY_URL=

# Set to "true" only once you are registered for GST — adds 10% GST to quotes
NEXT_PUBLIC_GST_REGISTERED=false

# Optional: real Stripe deposits. Leave empty to keep the checkout in simulation (test) mode.
# Use sk_test_... first, then sk_live_... when ready. Server-side only — never prefix with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=
